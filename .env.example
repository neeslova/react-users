# Адрес API (по умолчанию https://dummyjson.com).
# Чтобы показать состояние ошибки, можно указать несуществующий адрес.
DUMMYJSON_URL=https://dummyjson.com

# Искусственная задержка ответов DummyJSON в мс (0–5000), чтобы увидеть скелетоны и индикаторы загрузки.
DUMMYJSON_DELAY_MS=0

# Обязательно. Ключ шифрования cookie сессии Auth.js (не короче 32 символов).
# Сгенерировать: npx auth secret  (или: openssl rand -base64 33)
# Настоящее значение храните только в .env.local — он не попадает в git.
AUTH_SECRET=
